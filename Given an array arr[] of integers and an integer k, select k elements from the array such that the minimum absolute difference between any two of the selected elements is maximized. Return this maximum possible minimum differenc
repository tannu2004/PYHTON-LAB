class Solution:
    def maxMinDiff(self, arr, k):
        arr.sort()
        n = len(arr)

        def canPlace(dist):
            count = 1
            last = arr[0]

            for i in range(1, n):
                if arr[i] - last >= dist:
                    count += 1
                    last = arr[i]
                if count >= k:
                    return True
            return False

        left = 0
        right = arr[-1] - arr[0]
        ans = 0

        while left <= right:
            mid = (left + right) // 2

            if canPlace(mid):
                ans = mid
                left = mid + 1
            else:
                right = mid - 1

        return ans
